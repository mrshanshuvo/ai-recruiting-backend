    "p-limit": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.14",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^7.2.1",
