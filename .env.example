# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# Database & Cache Connections
MONGO_URI=mongodb://localhost:27017/ai-recruiting-co-worker
REDIS_URI=redis://localhost:6379

# AI / LLM Configuration (Mandatory)
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.7-flash

# Worker LLM Concurrency (Decision DEC-11 / ADR-0013)
WORKER_LLM_MAX_CONCURRENCY=3

# Search API (Optional: omit to use deterministic candidate fixtures per ADR-0010)
SERPER_API_KEY=

# Outreach Daily Quota & Sequence Delay Unit (Decisions DEC-12, DEC-20 / ADR-0006)
DAILY_SEND_LIMIT=50
# Use 'seconds' for 5-10 minute video demo; use 'days' for production calendar delays
OUTREACH_STEP_DELAY_UNIT=seconds

# Optional Live SMTP (Omit to use default Nodemailer Ethereal mock transport per ADR-0010)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

